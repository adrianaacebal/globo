            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Telepizza Sol\",\n  \"brand\": \"telepizza\",\n  \"area\": \"Centro\",\n  \"type\": \"pizza\",\n  \"lat\": 40.4169,\n  \"lon\": -3.7035,\n  \"id\": 999,\n  \"unknownField\": \"ignored\"\n}",
              "options": {
                "raw": {
                  "language": "json"
